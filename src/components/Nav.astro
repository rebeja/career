---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function isActive(path: string) {
  if (path === '/') return currentPath === base + '/' || currentPath === base;
  return currentPath.startsWith(base + path);
}
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="site-nav__inner">
    <a href={`${base}/`} class="site-nav__brand">Rebecca Alves</a>
    <ul class="site-nav__links">
      <li>
        <a href={`${base}/about`} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      </li>
      <li>
        <a href={`${base}/portfolio`} aria-current={isActive('/portfolio') ? 'page' : undefined}>Portfolio</a>
      </li>
      <li>
        <a href={`${base}/cv`} aria-current={isActive('/cv') ? 'page' : undefined}>CV</a>
      </li>
      <li>
        <a href={`${base}/contact`} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
      </li>
    </ul>
  </div>
</nav>
