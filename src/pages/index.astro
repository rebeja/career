---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const variant = (import.meta.env.SITE_VARIANT ?? 'external') as 'external' | 'internal';
const entries = await getCollection(variant);
const sorted = entries.sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const featuredSamples = [
  {
    type: 'API reference',
    title: 'Job Sync API',
    summary: 'A v1 GraphQL API reference and integration guide I wrote from scratch for docs.indeed.com.',
    href: 'https://docs.indeed.com/job-sync-api/job-sync-api-guide',
  },
  {
    type: 'Release notes',
    title: 'docs.indeed.com Release Notes',
    summary: 'The changelog I restructured by product, now staged by an automated pipeline.',
    href: 'https://docs.indeed.com/release-notes/',
  },
  {
    type: 'Procedural guide',
    title: 'Workday Installation Guide',
    summary: 'A high-traffic setup guide for IT administrators, built on the installation guide system I designed.',
    href: 'https://docs.indeed.com/install-guides/workday/',
  },
  {
    type: 'Webinar',
    title: 'From Writer to Tool Builder',
    summary: 'My Document360 webinar on AI coding agents for technical writers, with a starter repo and tutorials.',
    href: 'https://document360.com/webinar/from-writer-to-tool-builder-ai-coding-agents-for-technical-documentation/',
  },
];

---

<Base title="Rebecca Alves — Technical Writing Manager" description="Portfolio of Rebecca Alves, technical writing manager at Indeed: developer documentation, editorial standards, and AI tooling for docs.indeed.com.">
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Austin, Texas</p>
        <h1 class="hero__title">Rebecca Alves</h1>
        <p class="hero__subtitle">
          Technical writing manager at Indeed. I build the documentation, standards, and AI tooling behind docs.indeed.com, and I bring a background in rhetoric and university teaching to how I lead and coach writers.
        </p>
        <div style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
          <a href={`${base}/contact`} class="hero__cta">Get in touch →</a>
          <a href={`${base}/portfolio`} class="hero__secondary-link">Portfolio</a>
          <a href={`${base}/samples`} class="hero__secondary-link">Samples</a>
          <a href={`${base}/cv`} class="hero__secondary-link">CV</a>
          <a href="https://www.linkedin.com/in/rebeccaalvestechwriter/" target="_blank" rel="noopener noreferrer" class="hero__secondary-link">LinkedIn ↗</a>
          <a href="https://github.com/rebeja" target="_blank" rel="noopener noreferrer" class="hero__secondary-link">GitHub ↗</a>
        </div>
      </div>
      <div class="hero__photo">
        <img src={`${base}/profile-pic.jpg`} alt="Rebecca Alves" width="200" height="200" />
      </div>
    </div>
  </section>

  <hr class="section-divider container" />

  <!-- Portfolio -->
  <section class="container" style="padding-bottom: 4rem;">
    <h2 class="section-heading">Portfolio</h2>
    <p class="section-intro">Case studies of the systems I've built and led, from docs.indeed.com to the team that runs it.</p>
    <div class="card-grid">
      {sorted.map((entry) => (
        <CaseStudyCard
          title={entry.data.title}
          period={entry.data.period}
          role={entry.data.role}
          organization={entry.data.organization}
          summary={entry.data.summary}
          tags={entry.data.tags}
          href={`${base}/portfolio/${entry.slug}`}
          order={entry.data.order}
        />
      ))}
    </div>
    <p class="section-more"><a href={`${base}/portfolio`}>All case studies, with roles and dates →</a></p>
  </section>

  <hr class="section-divider container" />

  <!-- Samples -->
  <section class="container" style="padding-bottom: 4rem;">
    <h2 class="section-heading">Writing samples</h2>
    <p class="section-intro">Live documentation, release notes, and talks you can read today.</p>
    <div class="card-grid card-grid--compact">
      {featuredSamples.map((sample) => (
        <a href={sample.href} class="case-study-card" target="_blank" rel="noopener noreferrer">
          <div class="case-study-card__meta">{sample.type}</div>
          <div class="case-study-card__title">{sample.title}</div>
          <div class="case-study-card__summary">{sample.summary}</div>
        </a>
      ))}
    </div>
    <p class="section-more"><a href={`${base}/samples`}>All samples, including talks I coached and tutorials →</a></p>
  </section>

  <hr class="section-divider container" />

  <!-- Contact -->
  <section class="container" style="padding-bottom: 5rem;">
    <h2 class="section-heading">Get in touch</h2>
    <p style="max-width: 640px; color: var(--color-text-muted);">
      Want to talk about documentation, editorial standards, or AI tooling for writers? <a href={`${base}/contact`}>Send me a message</a>. For my full background, see the <a href={`${base}/cv`}>CV</a>, or find me on <a href="https://www.linkedin.com/in/rebeccaalvestechwriter/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
    </p>
  </section>
</Base>
